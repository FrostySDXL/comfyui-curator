# Image Curator configuration
# Copy this file to .env and adjust values for your environment.
# See README.md for full documentation.

# --- Paths ---
# Root directory for batch storage (inbox, shortlisted, finals, rejects).
# Default (when unset or commented): ~/image-curator/batches via Path.home().
# IMPORTANT: ~ in env-var values is NOT expanded by Python's pathlib.
# Use an absolute path, or leave commented to use the code default.
# IMAGE_CURATOR_BATCHES=/home/user/image-curator/batches

# Optional import source for images generated outside the batch library.
# Most users can leave this unset and save/copy images directly into:
#   IMAGE_CURATOR_BATCHES/<batch-name>/inbox/
# Set this only if ComfyUI writes somewhere else and you want Import All or
# the watcher to pull images into the active batch inbox.
# IMAGE_CURATOR_COMFYUI=/home/user/image-curator/comfyui-outputs

# Optional automation for the import source above. When true, new images in
# IMAGE_CURATOR_COMFYUI are moved into the active batch inbox. When false,
# Import All still works manually.
# Default: false.
# IMAGE_CURATOR_ENABLE_WATCHER=false

# State file location (persists active batch selection).
# Default (when unset or commented): ~/.config/image-curator/state.json
# IMAGE_CURATOR_STATE=/home/user/.config/image-curator/state.json

# Optional safe root for copying/moving generated public posting copies out of
# batch-local public/ folders. If unset, external Copy/Move Public Copies
# actions are disabled. Destinations entered in the UI must stay under this root.
# IMAGE_CURATOR_PUBLIC_EXPORTS=/home/user/image-curator/public-exports

# --- Network ---
# Host interface to bind the web UI to (default: 127.0.0.1)
# Use 0.0.0.0 to expose on all interfaces (only behind a reverse proxy with auth).
IMAGE_CURATOR_HOST=127.0.0.1

# Port to listen on (default: 5000)
IMAGE_CURATOR_PORT=5000

# --- AI scoring (optional) ---
# URL of the OpenAI-compatible vision LLM endpoint (e.g. llama-swap, llama.cpp server)
IMAGE_CURATOR_LLM_URL=http://localhost:8080

# Model name/alias to request from the LLM server.
# Required for AI scoring. Must match a model configured on your LLM server.
# Accepts a comma-separated list (e.g. "vl-scorer,qwen-vl") to populate a
# dropdown in the UI; the first entry is the default selection.
IMAGE_CURATOR_MODEL=

# Request timeout in seconds for AI scoring
IMAGE_CURATOR_TIMEOUT=120

# Optional API key for the vision LLM endpoint. Sent as a Bearer token in the
# Authorization header. Leave empty or unset to skip authentication.
# Only required if your llama-swap / llama.cpp server enforces auth.
# IMAGE_CURATOR_API_KEY=
